# Copy to .env.local for local run
SERVER_PORT=8083
DB_HOST=<shared-postgres-host>
DB_PORT=5432
DB_NAME=rebloom_biometric
DB_USERNAME=rebloom
DB_PASSWORD=<database-password>
DB_SSL_MODE=disable
SPRING_PROFILES_ACTIVE=local

# [Redis]
REDIS_HOST=<redis-host>
REDIS_PORT=<redis-port>

KAFKA_TOPIC_BIOMETRIC_RAW=<생체데이터 토픽>
KAFKA_TOPIC_EVENT_DLT=<DeadLetterTopic>
KAFKA_TOPIC_AI_MODEL_TRAIN_REQUEST=<모델훈련 요청 토픽>