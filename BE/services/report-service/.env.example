# Copy to .env.local for local run
SERVER_PORT=8084
DB_HOST=<shared-postgres-host>
DB_PORT=5432
DB_NAME=rebloom_report
DB_USERNAME=rebloom
DB_PASSWORD=<database-password>
DB_SSL_MODE=disable
SPRING_PROFILES_ACTIVE=local

KAFKA_BOOTSTRAP_SERVERS=<kafka-ports>
KAFKA_TOPIC_PARENT_REPORT_CREATED=<report-created-topic>
KAFKA_TOPIC_PARENT_REPORT_COMMENT_CREATED=<report-comment-topic>
KAFKA_TOPIC_STATUS_CARD_CREATED=<status-card-created>
KAFKA_TOPIC_EVENT_DLT=<event-dlt-topic>

AUTH_SERVICE_URL=<auth-service-url>
BIOMETRIC_SERVICE_URL=<biometric-service-url>
BIO_ML_SERVICE_URL=<bio-ml-service-url>
RECENT_INSIGHT_API_URL=<openai-compatible-chat-completions-url>
RECENT_INSIGHT_API_KEY=<recent-insight-api-key>
RECENT_INSIGHT_MODEL=gpt-4o-mini
