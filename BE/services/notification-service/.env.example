# Copy to .env.local for local run
SERVER_PORT=8085
DB_HOST=<shared-postgres-host>
DB_PORT=5432
DB_NAME=rebloom_notification
DB_USERNAME=rebloom
DB_PASSWORD=<database-password>
DB_SSL_MODE=disable
SPRING_PROFILES_ACTIVE=local

KAFKA_TOPIC_ANOMALY_ANALYSED=<이상치 검증 토픽>
KAFKA_TOPIC_EVENT_DLT=<DeadLetterTopic>

AUTH_SERVICE_URL=http:<AUTH_SERVICE_URL>

MQTT_BROKER_URI=<MQTT broker uri>
MQTT_CLIENT_ID_PREFIX=<client_id>
MQTT_QOS=<QOS settings>
MQTT_CONVERSATION_START_TOPIC_TEMPLATE=<topic template>

FIREBASE_SERVICE_ACCOUNT_PATH=<firebase-service-account.json>
FCM_DRY_RUN=false
