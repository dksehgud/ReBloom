# Copy to .env.local for local run
SERVER_PORT=8081
DB_HOST=<shared-postgres-host>
DB_PORT=5432
DB_NAME=rebloom_auth
DB_USERNAME=rebloom
DB_PASSWORD=<database-password>
DB_SSL_MODE=disable
SPRING_PROFILES_ACTIVE=local

# JWT
JWT_SECRET=<jwt-secret-key>
JWT_ACCESS_TOKEN_TIME=<access-token-valid-time>
JWT_REFRESH_TOKEN_TIME=<refresh-token-valid-time>