# Copy to .env.local for local Gradle bootRun.
# For Docker Compose, copy to .env and use service container names as URIs.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Service routing
AUTH_SERVICE_URI=http://localhost:8081
INTAKE_SERVICE_URI=http://localhost:8082
BIOMETRIC_SERVICE_URI=http://localhost:8083
REPORT_SERVICE_URI=http://localhost:8084
NOTIFICATION_SERVICE_URI=http://localhost:8085

# AI service routing
AIOT_AI_SERVICE_URI=http://localhost:8001
BIO_ML_SERVICE_URI=http://localhost:8002
EMOTION_INFERENCE_SERVICE_URI=http://localhost:8003

# CORS allowed origins
FRONTEND_URL=http://localhost:5174
FRONTEND_REDIRECT_URL=http://localhost:3000
# CloudFront deployment example:
# FRONTEND_URL=https://d1zs5r6o9orkcb.cloudfront.net
# FRONTEND_REDIRECT_URL=https://d1zs5r6o9orkcb.cloudfront.net

# JWT
JWT_SECRET=<jwt-secret-key>
