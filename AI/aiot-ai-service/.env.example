# ─────────────────────────────────────────────
# Re:Bloom LLM Server 환경변수 설정 예시
# 이 파일을 .env로 복사해서 사용한다.
# cp .env.example .env
# ─────────────────────────────────────────────

# 실행 환경 (development / production)
APP_ENV=development

# FastAPI 서버 포트 (라즈베리파이 등 외부에서 접근하는 포트)
SERVER_PORT=8000

# LLM 공급자 (vllm / openai)
LLM_PROVIDER=vllm

# vLLM OpenAI-compatible endpoint (내부 전용 포트 8001)
# vLLM은 내부에서만 실행, FastAPI가 외부 요청을 받아 프록시
OPENAI_BASE_URL=http://localhost:8001/v1

# vLLM 로컬 서버는 임의 문자열도 통과됨
OPENAI_API_KEY=EMPTY

# vLLM에 올려진 모델 이름 (--served-model-name과 동일해야 함)
LLM_MODEL=qwen3-8b-instruct

# ─────────────────────────────────────────────
# Mock LLM 모드 (vLLM 없이 로컬 테스트 시 True)
# ─────────────────────────────────────────────
USE_MOCK_LLM=True

# ─────────────────────────────────────────────
# 생성 파라미터
# ─────────────────────────────────────────────
MAX_NEW_TOKENS=150
TEMPERATURE=0.7
TOP_P=0.9

# LLM API 호출 타임아웃 (초)
LLM_TIMEOUT=30.0
