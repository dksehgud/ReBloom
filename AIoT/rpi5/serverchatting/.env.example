DEVICE_ID=rpi-001
LLM_SERVER_WS_URL=ws://localhost:8000/api/v1/chat/ws
USE_MOCK_STT=true
USE_MOCK_TTS=true
TTS_SENTENCE_DELAY=0.8
RECONNECT_MAX_RETRIES=3
RECONNECT_INTERVAL_SECONDS=2
LOG_LEVEL=WARNING
WAIT_TTS_BEFORE_NEXT_LISTEN=true
FILTER_LLM_REASONING_TEXT=true
BOOT_WIFI_WAIT_SECONDS=30
BOOT_WIFI_POLL_SECONDS=2
BOOT_WIFI_MONITOR_SECONDS=5
BOOT_WIFI_LOST_GRACE_SECONDS=15
BOOT_AUDIO_WAIT_SECONDS=15
AUDIO_OUTPUT_WAIT_SECONDS=30
ALLOW_HDMI_AUDIO_FALLBACK=false
BOOT_TTS_ENABLED=true
# DEVICE_REGISTRATION_URL=https://main.example.com/api/v1/devices/register

# 실제 STT 설정: USE_MOCK_STT=false일 때 사용
LISTEN_MODE=vad
RECORD_SECONDS=5
MAX_RECORD_SECONDS=20
SILENCE_SECONDS=1.2
START_TIMEOUT=8
WAKE_WORD_START_TIMEOUT=2
SPEECH_THRESHOLD=500
# auto가 실패하면 ALSA 기본 입력 장치를 사용합니다. 직접 지정하려면 plughw:2,0 형태로 설정합니다.
AUDIO_DEVICE=plughw:CARD=Device,DEV=0
STT_RETRY_SECONDS=5
MIC_BUSY_RETRY_SECONDS=10
START_SOUND=on
START_SOUND_FILE=/home/ssafy/project/S14P31B109/AIoT/rpi5/serverchatting/music/feedback.mp3
START_SOUND_PLAYER=pw-play
START_SOUND_DEVICE=
# 녹음 완료 후 STT 처리 시작 시 효과음 (on/off, 비우면 내장 효과음 사용)
STT_SOUND=on
STT_SOUND_FILE=
LANGUAGE=ko
WHISPER_BIN=/home/ssafy/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/ssafy/whisper.cpp/models/ggml-base.bin
WHISPER_THREADS=4
WHISPER_FAST=false
REPROMPT_ON_EMPTY=true
CONVERSATION_EMPTY_TURNS_TO_END=1
NO_INPUT_PROMPT=잘 못 들었어요. 다시 한 번 말해 주세요.

# 실제 TTS 설정: USE_MOCK_TTS=false일 때 사용
TTS_ENGINE=melotts
EDGE_VOICE=ko-KR-SunHiNeural
EDGE_RATE=+0%
EDGE_VOLUME=+0%
EDGE_PITCH=+0Hz
# 텍스트 내용에 따라 속도(rate)·음높이(pitch) 자동 조정 (true/false)
EDGE_EMOTION_AUTO=true
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=30
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.80
ELEVENLABS_STYLE=0.25
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_SPEED=0.95
MP3_PLAYER=pw-play
MP3_PLAYER_ARGS=
TTS_OUTPUT_FILE=
ESPEAK_VOICE=ko
PIPER_BIN=piper
PIPER_MODEL=
APLAY_BIN=aplay
HF_TTS_MODEL=facebook/mms-tts-kor
HF_TTS_DEVICE=cpu
HF_TTS_TORCH_DTYPE=auto
MELOTTS_LANGUAGE=KR
MELOTTS_SPEAKER=KR
MELOTTS_SPEED=1.0

# 대화 내역 서버 전송 설정: 비어 있으면 전송하지 않음
SESSION_EVENTS_URL=
SESSION_AUTH_HEADER=Authorization
SESSION_AUTH_TOKEN=
SESSION_AUTH_SCHEME=Bearer
SESSION_WINDOW_SECONDS=300
SESSION_SEND_TIMEOUT=5

# 대화 시작 트리거 설정
START_CONVERSATION_ON_BOOT=false
WAKE_WORD_ENABLED=true
WAKE_WORD_ENGINE=openwakeword
WAKE_WORDS=hi blooming,하이 블루밍
OPENWAKEWORD_MODEL_PATHS=/home/ssafy/project/S14P31B109/AIoT/rpi5/serverchatting/Wake_Model/hi_blooming.onnx
OPENWAKEWORD_THRESHOLD=0.7
OPENWAKEWORD_DEBUG=false
OPENWAKEWORD_REARM_SECONDS=3
OPENWAKEWORD_FLUSH_SECONDS=0.5
TRIGGER_API_HOST=0.0.0.0
TRIGGER_API_PORT=8085
TRIGGER_API_PATH=/api/v1/analyses/conversations
TRIGGER_GREETING=안녕! 무슨 일이 있니?

# MQTT 대화 시작 구독 설정
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=rpi-001
MQTT_PASSWORD=
MQTT_CLIENT_ID=rpi-001
MQTT_CONVERSATION_START_TOPIC=devices/rpi-001/conversation/start
MQTT_KEEPALIVE_SECONDS=60

# IR 센서 설정: MQTT 트리거 시 사람이 없으면 대화 무시
# IR_SENSOR_ENABLED=true 로 설정하면 활성화됩니다.
IR_SENSOR_ENABLED=false
IR_SENSOR_GPIO_PIN=23
# 마지막 움직임 감지 후 이 시간(초) 이상 지나면 MQTT 대화 트리거를 무시합니다.
IR_MOTION_TIMEOUT_SECONDS=30
