DEVICE_ID=rpi-001
LLM_SERVER_WS_URL=ws://localhost:8000/api/v1/chat/ws
USE_MOCK_STT=true
USE_MOCK_TTS=true
TTS_SENTENCE_DELAY=0.8
RECONNECT_MAX_RETRIES=3
RECONNECT_INTERVAL_SECONDS=2
LOG_LEVEL=WARNING
WAIT_TTS_BEFORE_NEXT_LISTEN=true
FILTER_LLM_REASONING_TEXT=true

# 실제 STT 설정: USE_MOCK_STT=false일 때 사용
LISTEN_MODE=vad
RECORD_SECONDS=5
MAX_RECORD_SECONDS=20
SILENCE_SECONDS=1.2
START_TIMEOUT=8
SPEECH_THRESHOLD=500
# auto가 실패하면 ALSA 기본 입력 장치를 사용합니다. 직접 지정하려면 plughw:2,0 형태로 설정합니다.
AUDIO_DEVICE=auto
STT_RETRY_SECONDS=5
MIC_BUSY_RETRY_SECONDS=10
START_SOUND=on
START_SOUND_PLAYER=auto
START_SOUND_DEVICE=
LANGUAGE=ko
WHISPER_BIN=/home/ssafy/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/home/ssafy/whisper.cpp/models/ggml-base.bin
WHISPER_THREADS=4
WHISPER_FAST=false
REPROMPT_ON_EMPTY=true
NO_INPUT_PROMPT=잘 못 들었어요. 다시 한 번 말해 주세요.

# 실제 TTS 설정: USE_MOCK_TTS=false일 때 사용
TTS_ENGINE=auto
EDGE_VOICE=ko-KR-SunHiNeural
EDGE_RATE=+0%
EDGE_VOLUME=+0%
MP3_PLAYER=mpg123
MP3_PLAYER_ARGS=
TTS_OUTPUT_FILE=
ESPEAK_VOICE=ko
PIPER_BIN=piper
PIPER_MODEL=
APLAY_BIN=aplay

# 대화 내역 서버 전송 설정: 비어 있으면 전송하지 않음
SESSION_EVENTS_URL=
SESSION_WINDOW_SECONDS=300
SESSION_SEND_TIMEOUT=5
