# Optional overrides for /etc/default/rebloom-voice

REBLOOM_PYTHON=/home/ssafy/project/S14P31B109/AIoT/rpi5/venv/bin/python
REBLOOM_MODEL=qwen2.5:1.5b
REBLOOM_OLLAMA_KEEP_ALIVE=30m
REBLOOM_OLLAMA_WARMUP=1
REBLOOM_NUM_PREDICT=96
REBLOOM_HISTORY_FILE=/home/ssafy/.rebloom/voice_history.json
REBLOOM_HISTORY_TURNS=2

# Conversation session upload. Leave URL empty to disable.
REBLOOM_SESSION_EVENTS_URL=
REBLOOM_DEVICE_ID=rebloom-rpi5
REBLOOM_SESSION_WINDOW_SECONDS=300
REBLOOM_SESSION_SEND_TIMEOUT=5

REBLOOM_WHISPER_BIN=/home/ssafy/whisper.cpp/build/bin/whisper-cli
REBLOOM_WHISPER_MODEL=/home/ssafy/whisper.cpp/models/ggml-base.bin
REBLOOM_WHISPER_FAST=1
REBLOOM_LISTEN_MODE=vad
REBLOOM_MAX_RECORD_SECONDS=20
REBLOOM_SILENCE_SECONDS=1.2
REBLOOM_START_TIMEOUT=2
REBLOOM_SPEECH_THRESHOLD=500
REBLOOM_MIN_SPEECH_SECONDS=0.3
REBLOOM_QUIET_LISTEN=1
REBLOOM_WAKE_ENGINE=openwakeword
REBLOOM_WAKE_MODE=always
REBLOOM_WAKE_WORDS="hi blooming,hey blooming,high blooming,hi bloomin,하이 블루밍,헤이 블루밍,하이블루밍,헤이블루밍,하이 블루민,하이블루민,하이브루밍,아이 블루밍,아이블루밍"
REBLOOM_WAKE_ACK="네, 말씀하세요."
REBLOOM_WAKE_DEBUG=0
REBLOOM_OPENWAKEWORD_MODELS=
REBLOOM_OPENWAKEWORD_THRESHOLD=0.5
REBLOOM_OPENWAKEWORD_REARM_SECONDS=2
REBLOOM_OPENWAKEWORD_NO_SPEECH_SUPPRESS_SECONDS=15
REBLOOM_OPENWAKEWORD_DEBUG=0
REBLOOM_OPENWAKEWORD_ACK_SOUND=on
REBLOOM_OPENWAKEWORD_ACK_DELAY_SECONDS=2
REBLOOM_AUDIO_DEVICE=auto
REBLOOM_OUTPUT_DEVICE=plughw:2,0
REBLOOM_TTS=edge
REBLOOM_EDGE_VOICE=ko-KR-SunHiNeural
REBLOOM_MP3_PLAYER=mpg123
REBLOOM_SKIP_WIFI_WAIT=0
REBLOOM_SKIP_OLLAMA_WAIT=0
REBLOOM_SKIP_AUDIO_WAIT=0
