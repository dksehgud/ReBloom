[Unit]
Description=Re:Bloom BLE Provisioning Service
Documentation=https://github.com/your-repo/rebloom
After=dbus.service bluetooth.service NetworkManager.service
Wants=bluetooth.service NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=__BLE_PROVISIONING_DIR__
ExecStart=__VENV_PYTHON__ __BLE_PROVISIONING_DIR__/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rebloom-ble

[Install]
WantedBy=multi-user.target
