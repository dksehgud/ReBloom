# Use an absolute gateway URL in deployed environments, or /api when the
# frontend host/reverse proxy forwards /api to the backend gateway.
VITE_API_BASE_URL=/api

# Local Vite dev-server proxy only. Leave empty when VITE_API_BASE_URL points
# directly to an API gateway or when your deploy platform handles /api routing.
VITE_DEV_API_PROXY_TARGET=
VITE_DEV_API_PROXY_ORIGIN=

VITE_KAKAO_MAP_APP_KEY=your-kakao-javascript-key
