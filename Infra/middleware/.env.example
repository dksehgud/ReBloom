# =================================================================
# Re:Bloom Project - Middleware Configuration Example
# =================================================================

# [Common]
# 컨테이너 및 서비스의 시간대 설정 (한국 표준시: Asia/Seoul)
TZ=Asia/Seoul

# [Kafka]
# Kafka 클러스터를 식별하는 고유 ID입니다. 
KAFKA_CLUSTER_ID=<your-unique-cluster-id>