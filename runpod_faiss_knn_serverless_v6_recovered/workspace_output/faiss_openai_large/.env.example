MODEL_DIR=/workspace/output/faiss_openai_large
KEYWORD_MODEL_DIR=/workspace/output/faiss_keywords
OPENAI_API_KEY=

# Embedding API base URL. This should be the OpenAI-compatible /v1 base, not /embeddings.
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# Set to 1 to summarize user input before embedding.
SUMMARIZE_INPUT=1

# Summary API POST endpoint. This is separate from OPENAI_BASE_URL, but uses the same API key.
SUMMARY_API_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/chat/completions
SUMMARY_MODEL=gpt-4o-mini
SUMMARY_MAX_CHARS=2500
SUMMARY_MAX_TOKENS=512
SUMMARY_TIMEOUT=120
SUMMARY_MAX_RETRIES=3
KEYWORD_TOP_N=3
KEYWORD_THRESHOLD=0.25

# Keep this at 1 for the CPU-only RunPod image.
NO_GPU=1
